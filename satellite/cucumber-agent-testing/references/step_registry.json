{
  "version": 1,
  "note": "离线编译用：自然语言步骤必须命中这些受控表达；未命中时 strict 模式报错。",
  "steps": [
    {
      "id": "background.local_ports",
      "pattern": "^使用当前 Polaris 本地串口配置$",
      "kind": "precondition",
      "actions": [],
      "assertions": ["serial.ready"]
    },
    {
      "id": "background.default_audio",
      "pattern": "^使用默认播放声卡$",
      "kind": "precondition",
      "actions": [],
      "assertions": ["audio.playback_ready"]
    },
    {
      "id": "background.debug_dir",
      "pattern": "^所有调试输出写入 Cucumber 调试目录$",
      "kind": "precondition",
      "actions": [],
      "assertions": ["debug.output_isolated"]
    },
    {
      "id": "wake.idle",
      "pattern": "^设备处于待唤醒状态$",
      "kind": "precondition",
      "contract": "wake.first_wake",
      "actions": [],
      "assertions": ["session.idle"]
    },
    {
      "id": "wake.play",
      "pattern": "^播放唤醒词$",
      "kind": "action",
      "contract": "wake.first_wake",
      "actions": [
        {"action": "audio.phrase_probe", "params": {"text": "{wake_word}", "label": "bdd_first_wake"}}
      ],
      "assertions": []
    },
    {
      "id": "wake.assert_observed",
      "pattern": "^应观察到 CP/AP/ASR 唤醒证据$",
      "kind": "assertion",
      "contract": "wake.first_wake",
      "actions": [],
      "assertions": ["cp_wake_count", "ap_wake_count", "asr_wake_count"]
    },
    {
      "id": "wake.failure_split",
      "pattern": "^未唤醒、播放失败或串口日志缺失应被区分归因$",
      "kind": "assertion",
      "contract": "wake.first_wake",
      "actions": [],
      "assertions": ["failure_split.wake"]
    },
    {
      "id": "wake.first_then_mode",
      "pattern": "^设备已经通过第一次唤醒进入识别模式$",
      "kind": "precondition",
      "contract": "wake.recognition_mode_wake",
      "actions": [],
      "assertions": ["first_wake_success", "session.in_recognition_window"]
    },
    {
      "id": "wake.rewake_in_window",
      "pattern": "^在识别超时窗口内再次播放唤醒词$",
      "kind": "action",
      "contract": "wake.recognition_mode_wake",
      "actions": [],
      "assertions": []
    },
    {
      "id": "wake.rewake_assert",
      "pattern": "^应观察到识别模式内的再次唤醒证据$",
      "kind": "assertion",
      "contract": "wake.recognition_mode_wake",
      "actions": [],
      "assertions": ["second_wake_observed", "no_timeout_before_second_wake"]
    },
    {
      "id": "wake.rewake_split",
      "pattern": "^需要区分识别窗口退出、音频链路失败和固件不支持$",
      "kind": "assertion",
      "contract": "wake.recognition_mode_wake",
      "actions": [],
      "assertions": ["failure_split.recognition_mode_wake"]
    },
    {
      "id": "network.online",
      "pattern": "^设备已联网到 \"(?P<wifi_ssid>[^\"]+)\"$",
      "kind": "precondition",
      "contract": "network.online",
      "actions": [
        {"action": "network.ensure_online", "params": {"wifi_ssid": "{wifi_ssid}", "label": "bdd_ensure_online"}}
      ],
      "assertions": ["network.hotspot_on", "network.device_attached", "network.cloud_online"]
    },
    {
      "id": "duplex.half_config",
      "pattern": "^云端或本地配置已切换为半双工$",
      "kind": "precondition",
      "contract": "duplex.half",
      "actions": [
        {"action": "network.ensure_online", "params": {"label": "bdd_ensure_online_half_duplex"}}
      ],
      "assertions": ["cloud_half_duplex_apply"]
    },
    {
      "id": "duplex.full_config",
      "pattern": "^云端或本地配置已切换为全双工$",
      "kind": "precondition",
      "contract": "duplex.full",
      "actions": [
        {"action": "network.ensure_online", "params": {"label": "bdd_ensure_online_full_duplex"}}
      ],
      "assertions": ["cloud_full_duplex_apply"]
    },
    {
      "id": "duplex.set_mode_param",
      "pattern": "^语音交互模式为 \"(?P<mode>半双工|全双工)\"(?:，?超时时间 (?P<timeout_s>\\d+) 秒)?$",
      "kind": "precondition",
      "contract": "duplex.mode",
      "actions": [
        {"action": "cloud.set_full_duplex", "params": {"enable": "{mode_enable}", "timeout_s": "{timeout_s}"}}
      ],
      "assertions": ["cloud_apply_success", "duplex_timeout_applied"]
    },
    {
      "id": "duplex.half_play",
      "pattern": "^播放唤醒词并在半双工识别窗口内播放命令词$",
      "kind": "action",
      "contract": "duplex.half",
      "actions": [],
      "assertions": []
    },
    {
      "id": "duplex.full_play",
      "pattern": "^播放唤醒词并在全双工识别窗口内连续播放命令词$",
      "kind": "action",
      "contract": "duplex.full",
      "actions": [],
      "assertions": []
    },
    {
      "id": "duplex.half_assert",
      "pattern": "^应观察到符合半双工预期的 ASR 和命令闭环$",
      "kind": "assertion",
      "contract": "duplex.half",
      "actions": [],
      "assertions": ["command_asr_or_keyword", "cloud_tts_response"]
    },
    {
      "id": "duplex.full_assert",
      "pattern": "^应观察到符合全双工预期的 ASR 和命令闭环$",
      "kind": "assertion",
      "contract": "duplex.full",
      "actions": [],
      "assertions": ["command_asr_or_keyword", "successful_response_count"]
    },
    {
      "id": "duplex.half_split",
      "pattern": "^播报中不应响应的输入不能误判为命令词失败$",
      "kind": "assertion",
      "contract": "duplex.half",
      "actions": [],
      "assertions": ["failure_split.duplex_half"]
    },
    {
      "id": "duplex.full_split",
      "pattern": "^播报中可识别、可打断或可连续对话需要按需求口径断言$",
      "kind": "assertion",
      "contract": "duplex.full",
      "actions": [],
      "assertions": ["failure_split.duplex_full"]
    },
    {
      "id": "command.data_ready",
      "pattern": "^已准备命令词词表和固定唤醒词$",
      "kind": "precondition",
      "contract": "command.basic_recognition",
      "actions": [],
      "assertions": ["command_file.readable", "wake_word.configured"]
    },
    {
      "id": "command.batch",
      "pattern": "^对每条命令词执行先唤醒再识别$",
      "kind": "action",
      "contract": "command.basic_recognition",
      "actions": [
        {"action": "fa2.command_batch", "params": {"label": "bdd_basic_command"}}
      ],
      "assertions": []
    },
    {
      "id": "command.batch_assert",
      "pattern": "^每条命令词应观察到唤醒、ASR 和命令关键词证据$",
      "kind": "assertion",
      "contract": "command.basic_recognition",
      "actions": [],
      "assertions": ["per_command.cp_wake_count", "per_command.asr_or_keyword"]
    },
    {
      "id": "command.failure_split",
      "pattern": "^FAIL 需要区分命令未播、未唤醒、未识别、词表期望不一致和设备行为问题$",
      "kind": "assertion",
      "contract": "command.basic_recognition",
      "actions": [],
      "assertions": ["failure_split.command_basic"]
    },
    {
      "id": "audio.play_text",
      "pattern": "^播放语音 \"(?P<text>[^\"]+)\"$",
      "kind": "action",
      "actions": [
        {"action": "audio.phrase_probe", "params": {"text": "{text}", "label": "bdd_play_text"}}
      ],
      "assertions": []
    },
    {
      "id": "assert.table_metrics",
      "pattern": "^串口证据应满足$",
      "kind": "assertion",
      "table": "metrics",
      "actions": [],
      "assertions": []
    }
  ]
}
