# keep runtime-heavy satellite outputs ignored, but publish the reusable Cucumber framework
!satellite/
satellite/*
!satellite/cucumber-agent-testing/
!satellite/cucumber-agent-testing/**
satellite/cucumber-agent-testing/debug/*
!satellite/cucumber-agent-testing/debug/.gitkeep
satellite/cucumber-agent-testing/**/__pycache__/
satellite/cucumber-agent-testing/**/*.pyc

# archived local runtime/debug evidence
_runtime/
